        "rsvp_side": {
          "name": "rsvp_side",
          "value": "\"rsvp\".\"side\" IN ('groom', 'bride')"
        },
        "rsvp_attendance": {
          "name": "rsvp_attendance",
          "value": "\"rsvp\".\"attendance\" IN ('yes', 'no')"
        },
        "rsvp_count": {
          "name": "rsvp_count",
          "value": "typeof(\"rsvp\".\"guest_count\") = 'integer' AND \"rsvp\".\"guest_count\" BETWEEN 0 AND 20"
        },
        "rsvp_meal": {
          "name": "rsvp_meal",
          "value": "\"rsvp\".\"meal\" IN ('yes', 'no', 'undecided')"
        },
        "rsvp_bus": {
          "name": "rsvp_bus",
          "value": "\"rsvp\".\"bus\" IN ('none', '대전', '경주')"
        },
        "rsvp_consent": {
          "name": "rsvp_consent",
          "value": "\"rsvp\".\"consent\" = 1"
        },
        "rsvp_attendance_fields": {
          "name": "rsvp_attendance_fields",
          "value": "(\"rsvp\".\"attendance\" = 'yes' AND \"rsvp\".\"guest_count\" >= 1) OR (\"rsvp\".\"attendance\" = 'no' AND \"rsvp\".\"guest_count\" = 0 AND \"rsvp\".\"meal\" = 'no' AND \"rsvp\".\"bus\" = 'none' AND \"rsvp\".\"companions\" = '')"
        }
      }
