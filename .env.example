PORT=3000
HOST=127.0.0.1
SITE_URL=http://localhost:3000
ADMIN_PASSWORD=여기에_충분히_긴_관리자_비밀번호를_입력하세요
DATA_DIR=./data
# 실제 배포 시 https 주소와 production을 지정합니다.
NODE_ENV=development
# 프록시가 정확히 1개일 때만 1로 설정합니다. 그 외에는 0을 유지합니다.
TRUST_PROXY_HOPS=0
# 카카오 개발자 콘솔의 JavaScript 키와 등록한 실제 서비스 주소가 필요합니다.
VITE_KAKAO_JAVASCRIPT_KEY=
